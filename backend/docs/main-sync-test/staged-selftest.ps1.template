Check (@(Sids-Of (Acl-Of (Join-Path $run 'secrets.dpapi'))).Count -eq 1 -and (Acl-Of (Join-Path $run 'secrets.dpapi')).AreAccessRulesProtected) 'interrupted write: the final file has the restrictive ACL'
Check ((Get-FileHash (Join-Path $run 'run-ids.json')).Hash -eq $idsHash -and @((FakeDb).registrations.PSObject.Properties).Count -eq 1 -and @((FakeDb).operations.PSObject.Properties).Count -eq 1) 'interrupted write: same identifiers, one registration, one operation'
