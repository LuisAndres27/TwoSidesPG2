# 5. stage G: removal of own temporaries only, verified absence, honest wording
Start-Fake; $run = New-Run; $null = Staged 'A' $run @('-ManifestPath', $ManifestReal); $null = Staged 'B' $run
$null = Staged 'C' $run @('-TestFaultAfterStep', 'session')
$hex = ('a' * 32)
'x' | Set-Content (Join-Path $run 'secrets.dpapi.tmp'); 'x' | Set-Content (Join-Path $run ('stage-state.json.tmp-' + $hex))
'keep' | Set-Content (Join-Path $run 'keep.tmp'); 'keep' | Set-Content (Join-Path $run 'stage-state.json.tmp-NOTHEX'); 'keep' | Set-Content (Join-Path $run 'notes.txt')
