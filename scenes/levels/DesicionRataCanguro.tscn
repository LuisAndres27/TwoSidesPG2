[node name="DesicionZorro" type="Node2D" unique_id=1938246463]
script = ExtResource("1_tgmip")
BiomeId = "desert"
Dialogo = PackedStringArray("Te encuentras en una situación difícil: tienes una camada de gatos no deseados en casa y necesitas una solución rápida. [Presiona espacio para continuar]", "Podrías abandonarlos a las afueras, en el desierto, ahorrando tiempo y dinero pensando que \'cazarán para sobrevivir\', aunque alteren el ecosistema. [Presiona espacio para continuar]", "La alternativa es asumir el costo económico y personal, invirtiendo tiempo en llevarlos a un refugio o pagando su esterilización. [Presiona espacio para continuar]")
Pregunta = "¿Decides abandonar a los gatos en el desierto para ahorrar tiempo y dinero?"
EscenaInfoBuena = "uid://dekxeby8v7pwq"
EscenaInfoMala = "uid://uepwdv0h6w2u"

