# staged-selftest.ps1.template — OFFLINE self-test of sync-test-staged.ps1 and build-second-op.mjs (B40). NOT run by the repository. Windows PowerShell 5.1.
# It uses ONLY disposable folders under -WorkDir, a node:http TEST DOUBLE on 127.0.0.1 (fake-sync-server.mjs, NOT Express, NOT Caddy, NOT Godot) and fake launchers that read the double's snapshot.
# No Atlas endpoint, no real launcher, no real authorization, no certificate and no real run folder are used. Run:
#   .\staged-selftest.ps1 -ToolsSource <backend\docs\main-sync-test> -WorkDir <empty absolute folder outside the project> -ExpectedTreeDigest <v4 digest> -ExpectedKeyFingerprint <fp>
param([Parameter(Mandatory = $true)][string]$ToolsSource, [Parameter(Mandatory = $true)][string]$WorkDir, [Parameter(Mandatory = $true)][string]$ExpectedTreeDigest, [Parameter(Mandatory = $true)][string]$ExpectedKeyFingerprint,
      [string]$Backend = 'C:\Users\luis2\OneDrive\Desktop\PRUEBA\TWO SIDES PRUEBA\Two-Sides PRUEBA\backend')
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName System.Security
$Node = 'C:\Program Files\nodejs\node.exe'
if (Test-Path $WorkDir) { if (@(Get-ChildItem $WorkDir -Force).Count) { throw 'WorkDir must be empty' } } else { New-Item -ItemType Directory $WorkDir | Out-Null }
$Tools = Join-Path $WorkDir 'tools'; $Runs = Join-Path $WorkDir 'runs'; $Auth = Join-Path $WorkDir 'auth'; $Out = Join-Path $WorkDir 'out'
foreach ($d in @($Tools, $Runs, $Auth, $Out)) { New-Item -ItemType Directory $d | Out-Null }
Copy-Item (Join-Path $ToolsSource 'sync-test-staged.ps1.template') (Join-Path $Tools 'staged.ps1')
Copy-Item (Join-Path $ToolsSource 'build-synthetic-run.mjs.template') (Join-Path $Tools 'build.mjs')
Copy-Item (Join-Path $ToolsSource 'build-second-op.mjs.template') (Join-Path $Tools 'second.mjs')
Copy-Item (Join-Path $ToolsSource 'fake-sync-server.mjs.template') (Join-Path $Tools 'fake.mjs')
Copy-Item (Join-Path $ToolsSource 'run-main-inspection-captured.ps1.template') (Join-Path $Tools 'wrapper-inspection.ps1')
Copy-Item (Join-Path $ToolsSource 'run-verify-synthetic.ps1.template') (Join-Path $Tools 'wrapper-verify.ps1')
$Staged = Join-Path $Tools 'staged.ps1'
@'
param([switch]$Enable,[string]$Authorization)
if($env:FAKE_INSPECT_FAIL -eq '1'){ exit 1 }
$id=[IO.Path]::GetFileNameWithoutExtension($Authorization) -replace '^main-inspection-authorization-',''; $dir=Split-Path -Parent $Authorization
$db=Get-Content -Raw $env:FAKE_DB | ConvertFrom-Json
$req=[ordered]@{}; foreach($k in 'operations','facts','fences','identities','ownerGuards','identitySessions','revocations'){ $req[$k]=@{name='main_v2_'+$k;present=$true;estimatedCount=[int]$db.counts.$k} }
$others=@(); foreach($p in $db.historical.PSObject.Properties){ $others+=@{name=$p.Name;estimatedCount=[int]$p.Value} }
$verdict='ready'; if($env:FAKE_INSPECT_VERDICT){$verdict=$env:FAKE_INSPECT_VERDICT}
$writes=0; if($env:FAKE_INSPECT_WRITES -eq '1'){$writes=1}
$closed=$true; if($env:FAKE_INSPECT_CLOSED -eq 'false'){$closed=$false}
$repId=$id; if($env:FAKE_INSPECT_BADID -eq '1'){$repId=('0'*32)}
$recVerdict=$verdict; if($env:FAKE_INSPECT_ALTER -eq '1'){$recVerdict='conflict'}
$finished=(Get-Date).ToUniversalTime(); if($env:FAKE_INSPECT_OLD -eq '1'){$finished=$finished.AddHours(-3)}
if($env:FAKE_INSPECT_NOREC -ne '1'){ @{kind='main-schema-inspection';executionId=$id;finishedAt=$finished.ToString('o');result=@{completed=$true;verdict=$recVerdict};note='No secrets.'} | ConvertTo-Json -Compress -Depth 5 | Set-Content (Join-Path $dir ($id+'.inspection.json')) -Encoding UTF8 }
$json = @{mainSchemaInspection='finished';executionId=$repId;verdict=$verdict;writes=$writes;requiredCollections=$req;otherCollections=$others;closed=$closed} | ConvertTo-Json -Compress -Depth 6
switch($env:FAKE_INSPECT_MODE){
  'empty' { }
  'badjson' { '{"mainSchemaInspection":"finished","verdict":' }
  'inherit' { $i=New-Object Diagnostics.ProcessStartInfo; $i.FileName='C:\Program Files\nodejs\node.exe'; $i.Arguments='-e "console.log(process.argv[1])" "'+($json -replace '"','\"')+'"'; $i.UseShellExecute=$false; $q=[Diagnostics.Process]::Start($i); $q.WaitForExit() }
  'noise' { [Console]::Error.WriteLine('npm warn something harmless'); 'WARNING: harmless notice before the report'; $json; 'trailing notice' }
  'exit5' { $json; exit 5 }
  default { $json }
}
'@ | Set-Content (Join-Path $Tools 'inspection-fake.ps1') -Encoding UTF8
@'
param([switch]$Enable,[string]$Authorization,[string]$RunDir,[string]$Account,[string]$Verifier)
if($env:FAKE_VERIFY_FAIL -eq '1'){ exit 1 }
$id=[IO.Path]::GetFileNameWithoutExtension($Authorization) -replace '^main-inspection-authorization-',''; $dir=Split-Path -Parent $Authorization
$db=Get-Content -Raw $env:FAKE_DB | ConvertFrom-Json; $ids=Get-Content -Raw (Join-Path $RunDir 'run-ids.json') | ConvertFrom-Json
$persisted = $null -ne $db.operations.PSObject.Properties[$ids.operationId]; $n = 0; if($persisted){$n=1}
$bad = ($env:FAKE_VERIFY_BAD -eq '1'); $verdict='inconsistent'; $failed=@('operation_not_persisted'); if($persisted -and -not $bad){$verdict='consistent';$failed=@()} elseif($persisted){$failed=@('forced')}
$sessions=[int]$db.counts.identitySessions-[int]$db.baseline.identitySessions
$repId=$id; if($env:FAKE_VERIFY_BADID -eq '1'){$repId=('0'*32)}
$finished=(Get-Date).ToUniversalTime(); if($env:FAKE_VERIFY_OLD -eq '1'){$finished=$finished.AddHours(-3)}
if($env:FAKE_VERIFY_NOREC -ne '1'){ @{kind='synthetic-run-verification';executionId=$id;finishedAt=$finished.ToString('o');verdict=$verdict;note='No secrets.'} | ConvertTo-Json -Compress | Set-Content (Join-Path $dir ($id+'.verification.json')) -Encoding UTF8 }
$json = @{syntheticRunVerification='finished';executionId=$repId;writes=0;verdict=$verdict;failed=$failed;counts=@{identities=1;ownerGuards=1;identitySessions=$sessions;operations=$n;facts=$n;fences=$n;revocations=0};closed=$true} | ConvertTo-Json -Compress -Depth 6
if($env:FAKE_VERIFY_MODE -eq 'empty'){ } elseif($env:FAKE_VERIFY_MODE -eq 'noise'){ [Console]::Error.WriteLine('noise on stderr'); 'plain notice'; $json } else { $json }
'@ | Set-Content (Join-Path $Tools 'verify-fake.ps1') -Encoding UTF8
$FakeInsp = Join-Path $Tools 'inspection-fake.ps1'; $FakeVer = Join-Path $Tools 'verify-fake.ps1'; $Dummy = Join-Path $Tools 'verify-dummy.mjs'; 'x' | Set-Content $Dummy
$Tiny = Join-Path $WorkDir 'tiny-backup'; New-Item -ItemType Directory $Tiny | Out-Null; 'backup test file' | Set-Content (Join-Path $Tiny 'a.txt')
$h = (Get-FileHash (Join-Path $Tiny 'a.txt')).Hash; "$h  a.txt" | Set-Content (Join-Path $Tiny 'SHA256SUMS.txt') -Encoding ascii

# ------------------------------------------------------------------------------------------------ harness
$pass = 0; $fail = 0; $failures = New-Object System.Collections.ArrayList
function Check([bool]$cond, [string]$name) { if ($cond) { $script:pass++; Write-Host ("  ok   " + $name) } else { $script:fail++; [void]$failures.Add($name); Write-Host ("  FAIL " + $name) -ForegroundColor Red } }
$AllOutput = New-Object System.Text.StringBuilder
$server = $null; $Port = 0; $DbFile = $null
function Start-Fake {
    $script:DbFile = Join-Path $Out ('db-' + [guid]::NewGuid().ToString('N') + '.json'); $outFile = $DbFile + '.out'
    $info = New-Object Diagnostics.ProcessStartInfo; $info.FileName = $Node; $info.Arguments = '"' + (Join-Path $Tools 'fake.mjs') + '" "' + $DbFile + '"'
    $info.UseShellExecute = $false; $info.RedirectStandardOutput = $true; $info.CreateNoWindow = $true
    $script:server = [Diagnostics.Process]::Start($info)
    $line = $server.StandardOutput.ReadLine(); $script:Port = [int]((ConvertFrom-Json $line).port)
}
function Stop-Fake { if ($script:server -and -not $script:server.HasExited) { $script:server.Kill(); $script:server.WaitForExit() }; $script:server = $null }
function Ctl($o) { Invoke-RestMethod -Uri "http://127.0.0.1:$Port/__ctl" -Method Post -Body (ConvertTo-Json $o -Compress -Depth 6) -ContentType 'application/json' | Out-Null }
function FakeDb { Invoke-RestMethod -Uri "http://127.0.0.1:$Port/__db" }
function FakeLog { Invoke-RestMethod -Uri "http://127.0.0.1:$Port/__log" }
function Node-Code([string[]]$arguments) {
    $info = New-Object Diagnostics.ProcessStartInfo; $info.FileName = $Node; $info.UseShellExecute = $false; $info.RedirectStandardOutput = $true; $info.RedirectStandardError = $true; $info.CreateNoWindow = $true
    $info.Arguments = (($arguments | ForEach-Object { '"' + $_ + '"' }) -join ' ')
    $p = [Diagnostics.Process]::Start($info); $o = $p.StandardOutput.ReadToEnd(); $null = $p.StandardError.ReadToEnd(); $p.WaitForExit(); return @{ Code = $p.ExitCode; Out = $o }
}
function New-Run {
    $dir = Join-Path $Runs ('run-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
    $r = & $Node (Join-Path $Tools 'build.mjs') $Backend $dir
    if ($LASTEXITCODE -ne 0) { throw 'build.mjs failed' }
    return $dir
}
function Phrase([string]$stage, [string]$dir) { $id = (Get-Content -Raw (Join-Path $dir 'run-ids.json') | ConvertFrom-Json).runId; return ('AUTORIZO-ETAPA-' + $stage + '-' + $id.Substring(0, 8)) }
function Staged([string]$stage, [string]$dir, [string[]]$extra = @(), [bool]$phrase = $true, [hashtable]$env = @{}, [bool]$common = $true) {
    $a = New-Object System.Collections.ArrayList
    [void]$a.AddRange(@('-NoProfile', '-File', $Staged, '-Stage', $stage))
    if ($dir) { [void]$a.AddRange(@('-RunDir', $dir)) }
    if ($phrase -and $dir) { [void]$a.AddRange(@('-ConfirmPhrase', (Phrase $stage $dir))) }
    if ($common) {
        $pairs = [ordered]@{ '-TestMode' = $null; '-BaseUrl' = "http://127.0.0.1:$Port"; '-InspectionLauncher' = $FakeInsp; '-VerifyLauncher' = $FakeVer; '-VerifierScript' = $Dummy; '-AuthorizationDir' = $Auth
            '-ProcessNames' = 'zz-no-such-process'; '-CheckPorts' = '59999'; '-RequestTimeoutSec' = '2'; '-ExpectedTreeDigest' = $ExpectedTreeDigest; '-ExpectedKeyFingerprint' = $ExpectedKeyFingerprint; '-BackupDirs' = $Tiny; '-BackendDir' = $Backend }
        foreach ($tok in $extra) { if ($tok.StartsWith('-') -and $pairs.Contains($tok)) { $pairs.Remove($tok) } }       # an explicit extra overrides the common value
        foreach ($k in $pairs.Keys) { [void]$a.Add($k); if ($null -ne $pairs[$k]) { [void]$a.Add([string]$pairs[$k]) } }
    }
    [void]$a.AddRange($extra)
    $info = New-Object Diagnostics.ProcessStartInfo; $info.FileName = 'powershell.exe'; $info.UseShellExecute = $false; $info.RedirectStandardOutput = $true; $info.RedirectStandardError = $true; $info.CreateNoWindow = $true
    $info.Arguments = (($a | ForEach-Object { '"' + ($_ -replace '"', '\"') + '"' }) -join ' ')
    $info.EnvironmentVariables['FAKE_DB'] = $DbFile; foreach ($k in $env.Keys) { $info.EnvironmentVariables[$k] = [string]$env[$k] }
    $p = [Diagnostics.Process]::Start($info); $stdout = $p.StandardOutput.ReadToEnd(); $stderr = $p.StandardError.ReadToEnd(); $p.WaitForExit()
    [void]$script:AllOutput.AppendLine($stdout); [void]$script:AllOutput.AppendLine($stderr)
    $json = $null; foreach ($line in ($stdout -split "`r?`n")) { if ($line.StartsWith('{"stagedSync"')) { try { $json = ConvertFrom-Json $line } catch { } } }
    return [pscustomobject]@{ Code = $p.ExitCode; Out = $stdout; Err = $stderr; Json = $json }
}
function State($dir) { return (Get-Content -Raw (Join-Path $dir 'stage-state.json') | ConvertFrom-Json) }
function Fast-To([string]$last, [string]$dir) {            # runs A..last, each with its own phrase, asserting exit 0
    foreach ($s in @('A', 'B', 'C', 'D', 'E')) { $r = Staged $s $dir; if ($r.Code -ne 0) { throw ("setup stage $s failed: " + $r.Code + ' ' + $r.Out) }; if ($s -eq $last) { return } }
}
function Unprotect-Blob($dir) {
    $id = (Get-Content -Raw (Join-Path $dir 'run-ids.json') | ConvertFrom-Json).runId
    $plain = [Security.Cryptography.ProtectedData]::Unprotect([IO.File]::ReadAllBytes((Join-Path $dir 'secrets.dpapi')), [Text.Encoding]::UTF8.GetBytes($id), 'CurrentUser')
    return (ConvertFrom-Json ([Text.Encoding]::UTF8.GetString($plain)))
}
$ManifestReal = Join-Path $env:LOCALAPPDATA 'TwoSidesMainIntegrity\backend-integrity-manifest.json'

# ================================================================================================ 0. integrity before
Write-Host '[0] integrity before'
$treeBefore = & $Node -e "const fs=require('fs'),c=require('crypto'),p=require('path');const out=[];const walk=d=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=p.join(d,e.name);e.isDirectory()?walk(f):out.push(f)}};process.chdir(process.argv[1]);walk('src');walk('scripts');['package.json','package-lock.json','vitest.config.js'].forEach(f=>out.push(f));const h=c.createHash('sha256');for(const f of out.sort())h.update(f+':'+c.createHash('sha256').update(fs.readFileSync(f)).digest('hex')+'\n');console.log(h.digest('hex'))" $Backend
$v0 = & $Node (Join-Path $Backend 'scripts\backend-integrity.js') verify $ManifestReal
Check ($v0 -match '"ok":true') 'manifest v4 verifies before the tests'
Check (@(Get-Process node, caddy -ErrorAction SilentlyContinue).Count -eq 0) 'no node/caddy process before the tests'

try {
# ================================================================================================ 1. parameters, authorization, no auto-advance
Write-Host '[1] parameter validation / stage F'
Start-Fake
$run = New-Run
Check ((Staged 'Z' $run @() $false).Code -eq 2) 'invalid stage letter is rejected (2)'
Check ((Staged 'A' $null @() $false @{} $true).Code -eq 2) 'missing RunDir is rejected (2)'
Check ((Staged 'A' $run @('-TestMode', '-BaseUrl', 'https://localhost:8443') $false @{} $false).Code -eq 2) 'TestMode with the real URL is rejected (2)'
Check ((Staged 'A' $run @('-BaseUrl', 'http://127.0.0.1:9') $false @{} $false).Code -eq 2) 'real mode with another URL is rejected (2)'
Check ((Staged 'A' $run @('-InspectionLauncher', $FakeInsp) $false @{} $false).Code -eq 2) 'test-only parameters without -TestMode are rejected (2)'
Check ((Staged 'A' $run @('-TestMode', '-BaseUrl', "http://127.0.0.1:$Port", '-InspectionLauncher', 'C:\x\run-main-inspection.ps1', '-VerifyLauncher', $FakeVer, '-VerifierScript', $Dummy) $false @{} $false).Code -eq 2) 'TestMode refuses the real inspection launcher (2)'
Check ((Staged 'A' $run @('-ProcessNames', 'x') $false @{} $false).Code -eq 2) 'real mode pins the service checks (2)'
$rF = Staged 'F' $run @() $false
Check ($rF.Code -eq 9) 'stage F is refused (9) and does nothing'
$rP = Staged 'C' $run @('-TestForbiddenProbe', 'DELETE:/api/v2/technical/me') $false
Check ($rP.Code -eq 2 -and $rP.Out -match 'allow-list') 'a DELETE / out-of-list HTTP call is refused by the allow-list (2)'
Check (@((FakeLog) | Where-Object { $_.method -eq 'DELETE' }).Count -eq 0) 'no DELETE ever reached the server'
Write-Host '[2] authorization / order'
Check ((Staged 'A' $run @() $false).Code -eq 10) 'stage A without the phrase: not authorized (10)'
$wrong = Staged 'A' $run @('-ConfirmPhrase', 'AUTORIZO-ETAPA-A-00000000') $false
Check ($wrong.Code -eq 10) 'a phrase of another run is rejected (10)'
Check (-not (Test-Path (Join-Path $run 'stage-state.json')) -or ((State $run).stages.PSObject.Properties.Count -eq 0)) 'nothing was recorded by refused calls'
Check ((Staged 'C' $run).Code -eq 11) 'C before A/B: prerequisite missing (11)'
Check ((Staged 'D' $run).Code -eq 11) 'D before C: prerequisite missing (11)'
Check ((Staged 'E' $run).Code -eq 11) 'E before D: prerequisite missing (11)'
Check ((Staged 'B' $run).Code -eq 11) 'B before A: prerequisite missing (11)'
Check (@((FakeLog) | Where-Object { $_.path -like '/api/v2/sync/*' }).Count -eq 0) 'no sync request was made by refused stages'
Stop-Fake

# ================================================================================================ 3. happy path A..G with REAL manifest + anchors
Write-Host '[3] full path A-B-C-D-E-G (real manifest/preflight, double server)'
Start-Fake; $run = New-Run
$rA = Staged 'A' $run @('-ManifestPath', $ManifestReal) $true @{} $true
Check ($rA.Code -eq 0 -and $rA.Json.status -eq 'ok') 'A: environment/integrity ok (real manifest, anchor, ACL, scan)'
Check ((State $run).stages.PSObject.Properties.Name -join ',' -eq 'A') 'A did not advance to B by itself'
Check ((Staged 'A' $run @('-ManifestPath', $ManifestReal)).Code -eq 11) 'a completed stage is never run twice (11)'
Check ((Staged 'C' $run).Code -eq 11) 'C refused while B has not run (11)'
$rB = Staged 'B' $run
Check ($rB.Code -eq 0 -and $rB.Json.status -eq 'ok') 'B: baseline recorded and equal to the expected one'
Check ((State $run).stages.PSObject.Properties.Name -join ',' -eq 'A,B') 'B did not advance to C by itself'
$rC = Staged 'C' $run
Check ($rC.Code -eq 0 -and $rC.Json.status -eq 'ok') 'C: one registration, one session, one committed operation'
$ids = Get-Content -Raw (Join-Path $run 'run-ids.json') | ConvertFrom-Json; $batchHash = (Get-FileHash (Join-Path $run 'batch.json')).Hash
$blob = Unprotect-Blob $run; $cred = $blob.credential; $tok = $blob.token
$rD = Staged 'D' $run
Check ($rD.Code -eq 0 -and $rD.Json.resultStatus -eq 'duplicate' -and $rD.Json.sameReceiptId -eq $true) 'D: identical re-send is a duplicate with the SAME receiptId'
$rE = Staged 'E' $run @('-IncludeNotFoundProbe')
Check ($rE.Code -eq 0 -and $rE.Json.deltasOk -eq $true) 'E: receipts/query found, final deltas exactly as expected'
$d = FakeDb
Check (@($d.operations.PSObject.Properties).Count -eq 1 -and $d.facts -eq 1) 'server: exactly 1 operation and 1 fact'
Check (@($d.registrations.PSObject.Properties).Count -eq 1) 'server: exactly 1 registration'
$batchReqs = @((FakeLog) | Where-Object { $_.path -eq '/api/v2/sync/batches' })
Check ($batchReqs.Count -eq 2 -and @($batchReqs.ops | Select-Object -Unique).Count -eq 1 -and $batchReqs[0].ops[0] -eq $ids.operationId) 'the SAME operationId was sent in both batches (C and D)'
Check ((Get-FileHash (Join-Path $run 'batch.json')).Hash -eq $batchHash) 'batch.json bytes unchanged'
Check ((State $run).logins -eq 1) 'a single session was needed (JWT reused from the protected blob)'
$secretBytes = [Text.Encoding]::UTF8.GetString([IO.File]::ReadAllBytes((Join-Path $run 'secrets.dpapi')))
Check (-not $secretBytes.Contains($cred) -and -not $secretBytes.Contains($tok)) 'secrets.dpapi does not contain the credential or the token in clear'
$hay = New-Object System.Text.StringBuilder
foreach ($f in Get-ChildItem $run -File | Where-Object { $_.Name -ne 'secrets.dpapi' }) { [void]$hay.AppendLine((Get-Content -Raw $f.FullName)) }
foreach ($f in Get-ChildItem $Auth -File) { [void]$hay.AppendLine((Get-Content -Raw $f.FullName)) }
[void]$hay.AppendLine($AllOutput.ToString()); [void]$hay.AppendLine((ConvertTo-Json (FakeLog) -Depth 6))
$H = $hay.ToString()
Check (-not $H.Contains($cred)) 'the credential is not in any file, log or output'
Check (-not $H.Contains($tok) -and -not ($H -match 'eyJ[A-Za-z0-9_-]+\.')) 'the JWT is not in any file, log or output'
$rG = Staged 'G' $run
Check ($rG.Code -eq 0 -and $rG.Json.secretsWiped -eq $true -and -not (Test-Path (Join-Path $run 'secrets.dpapi'))) 'G: protected secrets wiped, nothing active'
Check ((State $run).stages.G.status -eq 'ok') 'G recorded in the state'
Stop-Fake

# ================================================================================================ 4. manifest / configuration
Write-Host '[4] invalid manifest / incomplete configuration / id collisions'
Start-Fake; $run = New-Run
$bad = Join-Path $WorkDir 'bad-manifest.json'; $txt = Get-Content -Raw $ManifestReal; $txt.Replace('"fileCount":3169', '"fileCount":3168').Replace('"treeDigest":"aea0', '"treeDigest":"bbb0') | Set-Content $bad -NoNewline
$rBad = Staged 'A' $run @('-ManifestPath', $bad)
Check ($rBad.Code -eq 21 -and $rBad.Json.failedChecks -contains 'manifestVerify') 'A rejects a corrupted manifest (21)'
Check ((State $run).stages.A.status -eq 'failed') 'A recorded as failed; B stays blocked'
Check ((Staged 'B' $run).Code -eq 11) 'B refused after a failed A (11)'
$run2 = New-Run
$noAnchor = Staged 'A' $run2 @('-ManifestPath', $ManifestReal, '-ExpectedTreeDigest', 'abc') $true @{} $true
Check ($noAnchor.Code -eq 21 -and $noAnchor.Json.failedChecks -contains 'configuration') 'A rejects an incomplete/invalid anchor configuration (21)'
$run3 = New-Run
$wrongAnchor = Staged 'A' $run3 @('-ManifestPath', $ManifestReal, '-ExpectedTreeDigest', ('a' * 64))
Check ($wrongAnchor.Code -eq 21 -and $wrongAnchor.Json.failedChecks -contains 'preflight') 'A rejects a wrong tree-digest anchor (preflight fails, 21)'
$run4 = New-Run; $other = New-Run
Copy-Item (Join-Path $other 'run-ids.json') (Join-Path $run4 'run-ids.json') -Force
$collide = Staged 'A' $run4 @('-ManifestPath', $ManifestReal)
Check ($collide.Code -eq 21 -and $collide.Json.failedChecks -contains 'runMaterial') 'A rejects ids reused from another run (21)'
$run5 = New-Run; $ids5 = Get-Content -Raw (Join-Path $run5 'run-ids.json') | ConvertFrom-Json; $ids5.registrationId = '5e05a972-98ef-447a-9579-ba4d0e20a4b8'; $ids5 | ConvertTo-Json -Compress | Set-Content (Join-Path $run5 'run-ids.json') -NoNewline
Check ((Staged 'A' $run5 @('-ManifestPath', $ManifestReal)).Code -eq 21) 'A rejects an id of the previous real test (21)'
$run6 = New-Run; $b6 = Get-Content -Raw (Join-Path $run6 'batch.json'); $b6.Replace('"attempt":1', '"attempt":2') | Set-Content (Join-Path $run6 'batch.json') -NoNewline
Check ((Staged 'A' $run6 @('-ManifestPath', $ManifestReal)).Code -eq 21) 'A rejects a tampered batch (attempt/hash mismatch, 21)'
$run7 = New-Run; $busy = [Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback, 0); $busy.Start(); $busyPort = $busy.LocalEndpoint.Port
$rSrv = Staged 'A' $run7 @('-ManifestPath', $ManifestReal, '-CheckPorts', [string]$busyPort)
$busy.Stop()
Check ($rSrv.Code -eq 21 -and $rSrv.Json.failedChecks -contains 'noServers') 'A detects a listener on a checked port (21)'
$rProc = Staged 'A' (New-Run) @('-ManifestPath', $ManifestReal, '-ProcessNames', 'powershell')
Check ($rProc.Code -eq 21 -and $rProc.Json.failedChecks -contains 'noServers') 'A detects a running server-like process (21)'
Stop-Fake

# ================================================================================================ 5. interruption + resume
Write-Host '[5] interruption and safe resume'
Start-Fake; $run = New-Run; $null = Staged 'A' $run @('-ManifestPath', $ManifestReal); $null = Staged 'B' $run
$crash = Staged 'C' $run @('-TestFaultAfterStep', 'registration')
Check ($crash.Code -eq 99) 'process killed after the registration (simulated crash, 99)'
Check ((State $run).stages.C.status -eq 'started' -and (Test-Path (Join-Path $run 'stage.lock'))) 'state = started, stale lock left behind'
Check ((Staged 'C' $run).Code -eq 12) 'C without -Resume is refused (12)'
$account1 = (State $run).account
$res = Staged 'C' $run @('-Resume')
Check ($res.Code -eq 0) 'C -Resume completes with the SAME identifiers'
Check ((State $run).account -eq $account1 -and @((FakeDb).registrations.PSObject.Properties).Count -eq 1) 'no second registration/account was created'
Check (@((FakeDb).operations.PSObject.Properties).Count -eq 1) 'exactly one operation after the resume'
Stop-Fake

# ================================================================================================ 6. HTTP 503 / lost response / unknown
Write-Host '[6] simulated 503, lost responses and unknown outcomes (never a new operationId)'
foreach ($case in @(@{ n = '503 without results'; b = '503'; persisted = $false }, @{ n = '503 with deferred results'; b = '503-results'; persisted = $false },
                    @{ n = 'response lost AFTER commit'; b = 'dropAfterCommit'; persisted = $true }, @{ n = 'response lost BEFORE commit'; b = 'dropBeforeCommit'; persisted = $false })) {
    Start-Fake; $run = New-Run; $null = Staged 'A' $run @('-ManifestPath', $ManifestReal); $null = Staged 'B' $run
    Ctl @{ batch = @($case.b) }
    $c = Staged 'C' $run
    Check ($c.Code -eq 20 -and $c.Json.status -eq 'unknown') ($case.n + ': C reports UNKNOWN (20), not failure')
    Check ((State $run).stages.C.status -eq 'unknown') ($case.n + ': state C = unknown')
    Start-Sleep -Milliseconds 300
    $d = Staged 'D' $run
    Check ($d.Code -eq 0) ($case.n + ': D resolves it (verification, then identical re-send)')
    if ($case.persisted) { Check ($d.Json.resultStatus -eq 'duplicate') ($case.n + ': the re-send is a duplicate of the persisted operation') } else { Check ($d.Json.resultStatus -eq 'committed') ($case.n + ': the re-send commits it once') }
    $ops = @((FakeLog) | Where-Object { $_.path -eq '/api/v2/sync/batches' } | ForEach-Object { $_.ops } | Select-Object -Unique)
    Check ($ops.Count -eq 1) ($case.n + ': only ONE operationId ever reached the server')
    Check (@((FakeDb).operations.PSObject.Properties).Count -eq 1 -and (FakeDb).facts -eq 1) ($case.n + ': exactly one operation and one fact (no duplicates)')
    $e = Staged 'E' $run
    Check ($e.Code -eq 0 -and $e.Json.deltasOk) ($case.n + ': E confirms the final deltas')
    Stop-Fake
}

