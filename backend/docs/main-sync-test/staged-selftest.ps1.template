# ================================================================================================ 10c. capture of the launchers' report (B42)
Write-Host '[10c] launcher output capture: console-inheriting child, provenance checks, wrappers'
# 1. pinned hashes in the controller equal the templates
$ctlText = Get-Content -Raw (Join-Path $ToolsSource 'sync-test-staged.ps1.template')
foreach ($pin in @(@{ n = 'run-main-inspection-captured.ps1'; f = 'run-main-inspection-captured.ps1.template' }, @{ n = 'run-verify-synthetic.ps1'; f = 'run-verify-synthetic.ps1.template' })) {
    $m = [regex]::Match($ctlText, "'" + [regex]::Escape($pin.n) + "' = '([0-9A-F]{64})'")
    Check ($m.Success -and $m.Groups[1].Value -ceq (Get-FileHash (Join-Path $ToolsSource $pin.f) -Algorithm SHA256).Hash) ('the controller pins the SHA-256 of ' + $pin.n)
}
$wrapText = Get-Content -Raw (Join-Path $ToolsSource 'run-main-inspection-captured.ps1.template')
Check ($wrapText -match 'RedirectStandardOutput = \$true' -and $wrapText -match 'Environment\.Clear\(\)' -and $wrapText -match 'Read-Host -Prompt .*-AsSecureString') 'wrapper: redirects the child output, empties its environment, keeps the hidden prompt'
Check ($wrapText -notmatch 'ConvertFrom-SecureString|Out-File|Set-Content|Add-Content|Export-|\$env:|mongodb(\+srv)?://') 'wrapper: no persistence of the password, no environment reads, no connection string'
Check ((Staged 'A' (New-Run) @('-TestMode', '-BaseUrl', "http://127.0.0.1:$Port", '-InspectionLauncher', 'C:\x\run-main-inspection-captured.ps1', '-VerifyLauncher', $FakeVer, '-VerifierScript', $Dummy) $false @{} $false).Code -eq 2) 'TestMode refuses the capturing launcher too (2)'

# 2. controller: console-inheriting child and every provenance/format failure -> closed (21), nothing recorded as a baseline, nothing sent
