# ================================================================================================ 10b. DPAPI hardening (B41)
Write-Host '[10b] DPAPI file ACL, decryption failure, interrupted writes, temporaries, stage G cleanup'
function Acl-Of([string]$p) { return (New-Object IO.FileInfo $p).GetAccessControl() }
function Sids-Of($acl) { return @($acl.Access | ForEach-Object { $_.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value } | Sort-Object -Unique) }
function Reqs { return @((FakeLog) | Where-Object { $_.path -like '/api/*' }).Count }
$meSid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value

# 1. ACL applied to the file itself, verified after creation; resume keeps the same identity and credential
Start-Fake; $run = New-Run; $null = Staged 'A' $run @('-ManifestPath', $ManifestReal); $null = Staged 'B' $run
$crash = Staged 'C' $run @('-TestFaultAfterStep', 'session'); $sec = Join-Path $run 'secrets.dpapi'
Check ($crash.Code -eq 99 -and (Test-Path $sec)) 'DPAPI: the file exists after the simulated crash'
$acl = Acl-Of $sec; $sids = @(Sids-Of $acl)
Check ($acl.AreAccessRulesProtected) 'DPAPI ACL: inheritance is disabled on secrets.dpapi itself'
Check ($sids.Count -eq 1 -and $sids[0] -eq $meSid) 'DPAPI ACL: only the current user has an explicit rule (no Everyone/Users/Authenticated)'
Check (@(Get-ChildItem $run -Force | Where-Object { $_.Name -like '*.tmp*' }).Count -eq 0) 'DPAPI: no temporary file is left by a normal write'
$before = Unprotect-Blob $run; $acct = (State $run).account; $idsHash = (Get-FileHash (Join-Path $run 'run-ids.json')).Hash
$res = Staged 'C' $run @('-Resume')
$after = Unprotect-Blob $run
Check ($res.Code -eq 0 -and $after.credential -eq $before.credential -and (State $run).account -eq $acct -and (Get-FileHash (Join-Path $run 'run-ids.json')).Hash -eq $idsHash) 'DPAPI: resume reuses the same account, credential and identifiers'
Check (@((FakeDb).registrations.PSObject.Properties).Count -eq 1 -and @((FakeDb).operations.PSObject.Properties).Count -eq 1) 'DPAPI: still one registration and one operation after the resume'
Check (-not $AllOutput.ToString().Contains([string]$before.credential)) 'DPAPI: the credential never appeared in any output'
Check (-not (Test-Path (Join-Path $run 'secrets.dpapi.tmp'))) 'DPAPI: no secrets.dpapi.tmp after completion'
Stop-Fake

# 2. wrong ACL (extra Users rule / inheritance re-enabled): fail closed, nothing sent, nothing regenerated
foreach ($variant in @(@{ n = 'extra Users rule'; args = @('/grant', '*S-1-5-32-545:(R)') }, @{ n = 'inheritance re-enabled'; args = @('/inheritance:e') })) {
    Start-Fake; $run = New-Run; $null = Staged 'A' $run @('-ManifestPath', $ManifestReal); $null = Staged 'B' $run
    $null = Staged 'C' $run @('-TestFaultAfterStep', 'session'); $sec = Join-Path $run 'secrets.dpapi'
    & icacls $sec @($variant.args) | Out-Null
    $secHash = (Get-FileHash $sec).Hash; $acct = (State $run).account; $idsHash = (Get-FileHash (Join-Path $run 'run-ids.json')).Hash; $n0 = Reqs
    $r = Staged 'C' $run @('-Resume')
    Check ($r.Code -eq 21 -and $r.Json.reason -eq 'secrets-unavailable') ('DPAPI ACL (' + $variant.n + '): C -Resume fails closed (21, secrets-unavailable)')
    Check ((Reqs) -eq $n0) ('DPAPI ACL (' + $variant.n + '): no request of any kind was sent')
    Check ((Get-FileHash $sec).Hash -eq $secHash -and (State $run).account -eq $acct -and (Get-FileHash (Join-Path $run 'run-ids.json')).Hash -eq $idsHash) ('DPAPI ACL (' + $variant.n + '): file, account and identifiers unchanged')
    Check ($r.Err.Trim() -eq '' -and $r.Out -notmatch 'Exception|at <ScriptBlock>') ('DPAPI ACL (' + $variant.n + '): controlled error, no stack trace')
    $g = Staged 'G' $run
    Check ($g.Code -eq 0 -and $g.Json.secretsWiped -eq $true -and -not (Test-Path $sec)) ('DPAPI ACL (' + $variant.n + '): stage G still removes the file')
    Stop-Fake
}

# 3. decryption failure BEFORE the registration: controlled error, no request, no new identity
foreach ($variant in @('random bytes', 'blob of another run (wrong entropy)', 'empty file')) {
    Start-Fake; $run = New-Run; $null = Staged 'A' $run @('-ManifestPath', $ManifestReal); $null = Staged 'B' $run
    $crash = Staged 'C' $run @('-TestFaultAfterStep', 'secrets-written'); $sec = Join-Path $run 'secrets.dpapi'
