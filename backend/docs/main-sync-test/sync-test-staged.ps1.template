    [string]$BackendDir = 'C:\Users\luis2\OneDrive\Desktop\PRUEBA\TWO SIDES PRUEBA\Two-Sides PRUEBA\backend',
    [string]$BaseUrl = 'https://localhost:8443',
    [string]$ExpectedTreeDigest, [string]$ExpectedKeyFingerprint,
    [string]$ManifestPath = (Join-Path $env:LOCALAPPDATA 'TwoSidesMainIntegrity\backend-integrity-manifest.json'),
    [string]$SigningKeyFile = (Join-Path $env:LOCALAPPDATA 'TwoSidesMainSecrets\keys\main-jwt.pem'),
    [string]$KeyId = 'main-2026-11',
    [string]$ExpectedBaselineFile,
    [string]$AuthorizationDir = (Join-Path $env:LOCALAPPDATA 'TwoSidesInspection'),
    [string[]]$ProcessNames = @('node', 'caddy', 'Godot*'),
    [int[]]$CheckPorts = @(3000, 8443),
    [string[]]$BackupDirs = @((Join-Path $env:LOCALAPPDATA 'TwoSidesBackendBackups\pre-F1-20261102'), (Join-Path $env:LOCALAPPDATA 'TwoSidesBackendBackups\pre-F2-20261102')),
    [string]$CaThumbprint = 'F2BF0E8DC06AC9C4F12F27ECD6841438A5D412A7',
    [int]$CaddyPid, [switch]$StopCaddy, [int]$ExpressPid, [switch]$ForceStopExpress,
