# ------------------------------------------------------------------------------------------------ output (redacting)
function Redact([string]$text) {
    foreach ($s in $Secrets) { if ($s -and $s.Length -ge 8) { $text = $text.Replace($s, '***') } }
    return ([regex]::Replace($text, 'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]*', '***'))
}
function Say([string]$text) { [Console]::Out.WriteLine((Redact $text)) }
function Finish([int]$code, [string]$status, [hashtable]$extra = @{}) {
    $summary = [ordered]@{ stagedSync = $Stage; status = $status; exitCode = $code }
    foreach ($k in $extra.Keys) { $summary[$k] = $extra[$k] }
    Say (ConvertTo-Json $summary -Compress -Depth 8)
    if ($script:LockPath -and (Test-Path -LiteralPath $script:LockPath)) { Remove-Item -LiteralPath $script:LockPath -Force -ErrorAction SilentlyContinue }
    exit $code
}
function Stop-Param([string]$why) { Say ('REFUSED: ' + $why); Finish 2 'invalid-parameters' @{ reason = $why } }

