[node name="DesicionZorro" type="Node2D" unique_id=1938246463]
script = ExtResource("1_ddfnp")
BiomeId = "forest"
Dialogo = PackedStringArray("Los agricultores locales solicitan permisos para usar pesticidas de grado industrial cerca del bosque. Afirman que esto maximizará las cosechas enormemente. [Presiona espacio para continuar]\"", "Sin embargo, los biólogos advierten que estos químicos se filtrarán por el suelo, envenenando las raíces y matando la vegetación baja que alimenta a las presas pequeñas. [Presiona espacio para continuar]", "La decisión está en tus manos: maximizar la producción agrícola con químicos o subsidiar prácticas de agricultura orgánica para proteger el bosque. [Presiona espacio para continuar]")
Pregunta = "¿Otorgas los permisos para el uso de pesticidas industriales cerca del bosque?"
EscenaInfoBuena = "uid://ci45wgkyxbrhr"
EscenaInfoMala = "uid://cibe7yld52cqf"

