# run-verify-synthetic.ps1.template — manual launcher of the ONE-SHOT, READ-ONLY verification of the synthetic run (B31). NOT run by the repository.
# Copy it OUTSIDE the project next to verify.mjs (e.g. %LOCALAPPDATA%\TwoSidesSyntheticRun\run-verify-synthetic.ps1). Same hidden-input channel as run-main-inspection.ps1:
# the password is read with hidden input and sent to the child on stdin as one length-prefixed frame; it never appears in arguments, environment, files or output.
#   .\run-verify-synthetic.ps1 -Enable -Authorization <inspection-format authorization> -RunDir <run folder> -Account <technicalAccountId> -Verifier <verify.mjs>
param(
    [switch]$Enable,
    [Parameter(Mandatory = $true)][string]$Authorization,
    [Parameter(Mandatory = $true)][string]$RunDir,
    [Parameter(Mandatory = $true)][ValidatePattern('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')][string]$Account,
    [Parameter(Mandatory = $true)][string]$Verifier
)
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
if (-not $Enable) { Write-Error 'Synthetic run verification disabled: pass -Enable explicitly.'; exit 1 }
$node = 'C:\Program Files\nodejs\node.exe'
$backend = 'C:\Users\luis2\OneDrive\Desktop\PRUEBA\TWO SIDES PRUEBA\Two-Sides PRUEBA\backend'
foreach ($p in @($Authorization, $RunDir, $Verifier)) {
    if ($p -notmatch '^[A-Za-z]:\\[^"]+$' -or -not (Test-Path -LiteralPath $p)) { Write-Error 'Every path must be an existing absolute path without quotes.'; exit 1 }
    if ((Get-Item -LiteralPath $p).Attributes -band [IO.FileAttributes]::ReparsePoint) { Write-Error 'No path may be a link.'; exit 1 }
}
if (-not (Test-Path -LiteralPath $node -PathType Leaf)) { Write-Error 'Node is missing.'; exit 1 }

$secure = Read-Host -Prompt 'Password of the backend identity (hidden input)' -AsSecureString
$bstr = [IntPtr]::Zero; $chars = $null; $bytes = $null; $frame = $null; $process = $null; $consoleInput = $null
try {
    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure)
    $chars = New-Object 'char[]' $secure.Length
    for ($i = 0; $i -lt $chars.Length; $i++) { $chars[$i] = [char]([Runtime.InteropServices.Marshal]::ReadInt16($bstr, 2 * $i) -band 0xFFFF) }
    $bytes = [Text.Encoding]::UTF8.GetBytes($chars)
    if ($bytes.Length -lt 1 -or $bytes.Length -gt 1024 -or ($chars -contains "`r") -or ($chars -contains "`n") -or ($chars -contains [char]0)) { Write-Error 'Invalid credential.'; exit 1 }
    $frame = New-Object 'byte[]' (4 + $bytes.Length)
    $frame[0] = ($bytes.Length -shr 24) -band 255; $frame[1] = ($bytes.Length -shr 16) -band 255; $frame[2] = ($bytes.Length -shr 8) -band 255; $frame[3] = $bytes.Length -band 255
    [Array]::Copy($bytes, 0, $frame, 4, $bytes.Length)
    $info = New-Object Diagnostics.ProcessStartInfo
    $info.FileName = $node; $info.WorkingDirectory = $backend; $info.UseShellExecute = $false; $info.RedirectStandardInput = $true
    $info.RedirectStandardOutput = $true; $info.RedirectStandardError = $true                  # B42: capture the report (the console-inherited child output never reached the controller)
    $info.StandardOutputEncoding = [Text.Encoding]::UTF8; $info.StandardErrorEncoding = [Text.Encoding]::UTF8
    $info.Arguments = '"' + $Verifier + '" --enable-synthetic-verification --authorization "' + $Authorization + '" --run-dir "' + $RunDir + '" --account ' + $Account + ' --backend "' + $backend + '"'
    $info.Environment.Clear()                                                  # nothing inherited: no secrets, no NODE_OPTIONS, no proxy
    $windows = [Environment]::GetFolderPath('Windows')
    $info.Environment['SystemRoot'] = $windows; $info.Environment['windir'] = $windows; $info.Environment['PATH'] = Join-Path $windows 'System32'
    $consoleInput = [Console]::InputEncoding
    if ($consoleInput.GetPreamble().Length -gt 0) { [Console]::InputEncoding = [Text.Encoding]::GetEncoding(1252) } else { $consoleInput = $null }
    try { $process = [Diagnostics.Process]::Start($info) } finally { if ($consoleInput) { [Console]::InputEncoding = $consoleInput; $consoleInput = $null } }
    $outTask = $process.StandardOutput.ReadToEndAsync(); $errTask = $process.StandardError.ReadToEndAsync()   # started before writing: no pipe deadlock
    $process.StandardInput.BaseStream.Write($frame, 0, $frame.Length)
    $process.StandardInput.BaseStream.Flush(); $process.StandardInput.Close()
    [Array]::Clear($frame, 0, $frame.Length); [Array]::Clear($bytes, 0, $bytes.Length); [Array]::Clear($chars, 0, $chars.Length)
    $process.WaitForExit()
    $code = $process.ExitCode
    $stdoutText = [string]$outTask.Result; $stderrText = [string]$errTask.Result
    foreach ($line in ($stderrText -split "`r?`n")) { if ($line.Trim()) { Write-Host ('[verification stderr] ' + $line.Trim()) } }
    $lines = @($stdoutText -split "`r?`n" | Where-Object { $_.Trim() } | ForEach-Object { $_.Trim() })
    foreach ($line in $lines) { Write-Output $line }
    if ($code -ne 0) { exit $code }
    if ($lines.Count -eq 0) { Write-Host 'The verification produced no output; treating it as a failure.'; exit 3 }
    exit 0
}
finally {
    if ($bstr -ne [IntPtr]::Zero) { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr) }
    if ($secure) { $secure.Dispose() }
    foreach ($buffer in @($frame, $bytes, $chars)) { if ($buffer) { [Array]::Clear($buffer, 0, $buffer.Length) } }
    if ($process -and -not $process.HasExited) { if (-not $process.WaitForExit(10000)) { $process.Kill() } }
}
