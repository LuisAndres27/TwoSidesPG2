[node name="DesicionZorro" type="Node2D" unique_id=1938246463]
script = ExtResource("1_d5set")
BiomeId = "jungle"
Dialogo = PackedStringArray("Se ha propuesto construir una nueva vía férrea para acelerar el transporte de mercancías. La ruta más barata y rápida atraviesa directamente el corazón de la selva. [Presiona espacio para continuar]", "Pero construirla requeriría talar árboles a ras de suelo. Esto fragmentaría el ecosistema, dejando a los animales sin alimento y sin refugio ante depredadores. [Presiona espacio para continuar]", "Tienes que decidir: ahorrar presupuesto atravesando la selva o gastar más dinero rodeando el ecosistema para proteger su integridad. [Presiona espacio para continuar]")
Pregunta = "¿Autorizas la construcción de la vía a través de la selva para ahorrar presupuesto?"
EscenaInfoBuena = "uid://dka8dg2wbaqqq"
EscenaInfoMala = "uid://dc7qjn0ttcpdt"

