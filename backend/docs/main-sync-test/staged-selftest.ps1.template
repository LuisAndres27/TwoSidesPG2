$idsHash = (Get-FileHash (Join-Path $run 'run-ids.json')).Hash; $runIdBefore = (State $run).runId; $opBefore = (Get-Content -Raw (Join-Path $run 'run-ids.json') | ConvertFrom-Json).operationId
$cases = @(
    @{ n = 'child with inherited console (the real defect)'; e = @{ FAKE_INSPECT_MODE = 'inherit' }; m = 'printed nothing capturable' },
    @{ n = 'empty output'; e = @{ FAKE_INSPECT_MODE = 'empty' }; m = 'printed nothing capturable' },
    @{ n = 'malformed JSON'; e = @{ FAKE_INSPECT_MODE = 'badjson' }; m = 'no JSON report' },
    @{ n = 'valid JSON but exit code 5'; e = @{ FAKE_INSPECT_MODE = 'exit5' }; m = 'exit code 5' },
    @{ n = 'report with another executionId'; e = @{ FAKE_INSPECT_BADID = '1' }; m = 'executionId differs' },
    @{ n = 'no local record (report cannot be tied to the launcher)'; e = @{ FAKE_INSPECT_NOREC = '1' }; m = 'no local record' },
    @{ n = 'old record reused'; e = @{ FAKE_INSPECT_OLD = '1' }; m = 'stale' },
    @{ n = 'record altered (verdict differs)'; e = @{ FAKE_INSPECT_ALTER = '1' }; m = 'does not confirm' },
    @{ n = 'writes != 0'; e = @{ FAKE_INSPECT_WRITES = '1' }; m = 'writes is not 0' },
    @{ n = 'closed != true'; e = @{ FAKE_INSPECT_CLOSED = 'false' }; m = 'closed is not true' },
    @{ n = 'verdict not ready'; e = @{ FAKE_INSPECT_VERDICT = 'partial' }; m = '' })
$first = $true
foreach ($c in $cases) {
    $r = if ($first) { Staged 'B' $run @() $true $c.e } else { Staged 'B' $run @('-Resume') $true $c.e }; $first = $false
    Check ($r.Code -eq 21 -and ($c.m -eq '' -or $r.Out -match [regex]::Escape($c.m))) ('B fails closed (21): ' + $c.n)
