    if ([IO.Path]::GetFullPath($BackendDir) -ne [IO.Path]::GetFullPath($RealBackend)) { Stop-Param 'BackendDir is pinned.' }
    if ($InspectionLauncher -or $VerifyLauncher -or $VerifierScript -or $TestFaultAfterStep -or $TestForbiddenProbe) { Stop-Param 'Test-only parameters are not allowed without -TestMode.' }
    if (($ProcessNames -join ',') -ne 'node,caddy,Godot*' -or ($CheckPorts -join ',') -ne '3000,8443') { Stop-Param 'Service checks are pinned (node, caddy, Godot*; ports 3000, 8443).' }
}
if ($Stage -eq 'F') { Say 'Stage F (controlled loss of the response) is OUT OF SCOPE of this campaign: it needs a separate written authorization and build-second-op.mjs. Nothing was done.'; Finish 9 'out-of-scope' }
if ($TestForbiddenProbe) {                                         # test hook: proves the allow-list refuses before any request is made
    $probe = $TestForbiddenProbe
    if ($Allowed -contains $probe.Replace(':', ' ')) { Stop-Param 'probe is allowed' }
    Stop-Param ('HTTP call not in the allow-list: ' + $probe)
}
if (-not $RunDir -and $Stage -ne 'G') { Stop-Param 'RunDir is required.' }
