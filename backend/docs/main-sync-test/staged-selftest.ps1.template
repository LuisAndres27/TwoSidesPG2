    switch ($variant) {
        'random bytes' { $junk = New-Object byte[] 200; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($junk); [IO.File]::WriteAllBytes($sec, $junk) }
        'empty file' { [IO.File]::WriteAllBytes($sec, [byte[]]@()) }
        default { [IO.File]::WriteAllBytes($sec, [Security.Cryptography.ProtectedData]::Protect([Text.Encoding]::UTF8.GetBytes('{"credential":"x","token":null}'), [Text.Encoding]::UTF8.GetBytes('another-run-id'), 'CurrentUser')) }
    }
    $idsHash = (Get-FileHash (Join-Path $run 'run-ids.json')).Hash; $n0 = Reqs
    $r = Staged 'C' $run @('-Resume')
    Check ($r.Code -eq 21 -and $r.Json.reason -eq 'secrets-unavailable') ('DPAPI decrypt (' + $variant + '): controlled failure (21, secrets-unavailable)')
    Check ((Reqs) -eq $n0 -and @((FakeDb).registrations.PSObject.Properties).Count -eq 0) ('DPAPI decrypt (' + $variant + '): no request sent, no registration')
    Check ($null -eq (State $run).account -and (Get-FileHash (Join-Path $run 'run-ids.json')).Hash -eq $idsHash -and (State $run).logins -eq 0) ('DPAPI decrypt (' + $variant + '): no new identity, account or login')
    Check ($r.Err.Trim() -eq '' -and $r.Out -notmatch 'Exception|at <ScriptBlock>') ('DPAPI decrypt (' + $variant + '): no stack trace or raw error')
    Stop-Fake
}
# decryption failure in a later stage: nothing is re-sent
Start-Fake; $run = New-Run; Fast-To 'C' $run
$junk = New-Object byte[] 120; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($junk); [IO.File]::WriteAllBytes((Join-Path $run 'secrets.dpapi'), $junk)
$batches0 = @((FakeLog) | Where-Object { $_.path -eq '/api/v2/sync/batches' }).Count
$rd = Staged 'D' $run
