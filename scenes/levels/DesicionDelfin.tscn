[node name="DesicionZorro" type="Node2D" unique_id=1938246463]
script = ExtResource("1_0ye6j")
Dialogo = PackedStringArray("Tienes que deshacerte de basura pesada en tu hogar: aceite de motor viejo, limpiadores químicos y llantas usadas. [Presiona espacio para continuar]", "Lo más rápido sería tirarlos por el desagüe o en un vertedero ilegal. Pero estos químicos terminan en el océano, provocando el letal blanqueamiento de los corales. [Presiona espacio para continuar]", "La otra opción es hacer un esfuerzo extra y llevar estos desechos a un centro de reciclaje autorizado, asumiendo el gasto y el tiempo. [Presiona espacio para continuar]")
Pregunta = "¿Tiras los químicos por el desagüe y abandonas la basura para evitar el esfuerzo extra?"
EscenaInfoBuena = "uid://jbo1mud1807u"
EscenaInfoMala = "uid://dko6gyt42ocj1"

