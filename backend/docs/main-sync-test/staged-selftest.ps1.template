$stB = State $run
Check ($stB.stages.B.status -eq 'failed' -and $null -eq $stB.baseline) 'B stays failed and no baseline was recorded by any rejected output'
Check (@((FakeLog) | Where-Object { $_.path -like '/api/v2/*' }).Count -eq 0) 'no API request of the test was sent while B was failing'
Check ((Staged 'B' $run @() $true @{}).Code -eq 12) 'B after a failure needs -Resume (12)'
Check ((Staged 'C' $run).Code -eq 11) 'C stays blocked while B is failed (11)'
